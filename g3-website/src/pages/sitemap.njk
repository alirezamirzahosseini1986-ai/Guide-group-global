---
permalink: "/sitemap.xml"
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- for key, slug in routes %}
{%- for l in langs %}
  <url>
    <loc>{{ key | localUrl(l.code) | abs }}</loc>
    <lastmod>{{ page.date.toISOString().slice(0, 10) }}</lastmod>
    <changefreq>{% if key == "golden" or key == "home" %}weekly{% else %}monthly{% endif %}</changefreq>
    <priority>{% if key == "home" %}1.0{% elif key == "privacy" %}0.3{% else %}0.8{% endif %}</priority>
    {%- for a in langs %}
    <xhtml:link rel="alternate" hreflang="{{ a.code }}" href="{{ key | localUrl(a.code) | abs }}"/>
    {%- endfor %}
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ '/' | abs }}"/>
  </url>
{%- endfor %}
{%- endfor %}
</urlset>
