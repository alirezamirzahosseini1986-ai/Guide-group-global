---
permalink: "/site.webmanifest"
eleventyExcludeFromCollections: true
---
{
  "name": "{{ site.brand.name }}",
  "short_name": "{{ site.brand.short }}",
  "start_url": "{{ site.prefix }}/",
  "display": "standalone",
  "background_color": "#070b14",
  "theme_color": "#070b14",
  "icons": [
    { "src": "{{ site.prefix }}/assets/img/favicon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "{{ site.prefix }}/assets/img/apple-touch-icon.png", "sizes": "180x180", "type": "image/png" },
    { "src": "{{ site.prefix }}/assets/img/icon-512.png", "sizes": "512x512", "type": "image/png" }
  ]
}
