---
pagination:
  data: langs
  size: 1
  alias: lang
pageKey: home
layout: base.njk
permalink: "/{{ lang.code }}/"
eleventyComputed:
  preloadImage: "{{ i18n[lang.code].home.hero.image }}"
---
{%- import "macros.njk" as m -%}
{%- set L = lang.code -%}
{%- set d = i18n[L].home -%}
{%- set ui = i18n[L].ui -%}

<section class="hero" data-hero aria-labelledby="hero-title">
  <div class="hero-scene">
    <div class="hero-media" data-depth="0.4">
      {%- if d.hero.video %}
      <video autoplay muted loop playsinline poster="{{ d.hero.image | img(1920, 1271) }}" aria-hidden="true"><source src="{{ d.hero.video }}" type="video/mp4"></video>
      {%- else %}
      {{ m.picture(d.hero.image, d.hero.image_alt, 1920, 1.51, "100vw", true) }}
      {%- endif %}
    </div>
    <div class="hero-shade"></div>
    <div class="cloud cloud-1" data-depth="1.4"></div>
    <div class="cloud cloud-2" data-depth="1"></div>
    <div class="cloud cloud-3" data-depth="0.7"></div>
    <canvas class="hero-dust" aria-hidden="true"></canvas>
    <div class="hero-horizon" aria-hidden="true"></div>
  </div>

  <div class="container hero-content">
    <p class="eyebrow" data-hero-fade>{{ d.hero.eyebrow }}</p>
    <h1 class="hero-title" id="hero-title">
      <span class="hero-line-wrap"><span class="hero-line">{{ d.hero.title_1 }}</span></span>
      <span class="hero-line-wrap"><span class="hero-line hero-line-accent">{{ d.hero.title_2 }}</span></span>
    </h1>
    <p class="lead hero-sub" data-hero-fade>{{ d.hero.subtitle }}</p>
    <div class="hero-actions" data-hero-fade>
      <a class="btn btn-gold btn-lg" href="{{ 'consult' | localUrl(L) }}">{{ d.hero.cta_primary }} <span class="arrow" aria-hidden="true">→</span></a>
      <a class="btn btn-ghost btn-lg" href="#paths">{{ d.hero.cta_secondary }}</a>
    </div>
  </div>

  <a class="scroll-hint" href="#intro" data-hero-fade><span class="scroll-line" aria-hidden="true"></span>{{ ui.scroll_hint }}</a>
</section>

<section class="section intro" id="intro" aria-labelledby="intro-k">
  <div class="container">
    <p class="eyebrow" id="intro-k" data-reveal>{{ d.intro.kicker }}</p>
    <p class="statement" data-split>{{ d.intro.statement }}</p>
    <div class="intro-grid">
      <p class="body-lg" data-reveal>{{ d.intro.text }}</p>
      <dl class="stats">
        {%- for s in d.stats %}
        <div class="stat" data-reveal="{{ loop.index0 }}">
          <dt class="stat-label">{{ s.label }}</dt>
          <dd class="stat-num"><bdi dir="ltr"><span data-count="{{ s.number }}">{{ s.number | num(L) }}</span>{{ s.suffix }}</bdi></dd>
        </div>
        {%- endfor %}
      </dl>
    </div>
  </div>
</section>

<section class="section values" aria-labelledby="values-title">
  <div class="container">
    {{ m.sectionHead(d.values.kicker, d.values.title, "", "values-title") }}
    <ol class="values-grid">
      {%- for v in d.values.items %}
      <li class="value" data-reveal="{{ loop.index0 }}">
        <span class="value-n" aria-hidden="true">{{ loop.index | pad2(L) }}</span>
        <h3>{{ v.title }}</h3>
        <p>{{ v.text }}</p>
      </li>
      {%- endfor %}
    </ol>
  </div>
</section>

<section class="section paths" id="paths" aria-labelledby="paths-title">
  <div class="container">
    {{ m.sectionHead(d.paths.kicker, d.paths.title, d.paths.text, "paths-title") }}
  </div>
  <div class="container stack">
    {%- for p in d.paths.items %}
    <article class="stack-card" style="--i:{{ loop.index0 }}">
      <div class="stack-inner">
        <div class="stack-media">{{ m.picture(p.image, p.image_alt, 1200, 1.25, "(min-width: 900px) 50vw, 100vw") }}</div>
        <div class="stack-body">
          <span class="stack-n" aria-hidden="true">{{ loop.index | pad2(L) }} / {{ d.paths.items | length | pad2(L) }}</span>
          <h3 class="display-md">{{ p.title }}</h3>
          <p>{{ p.text }}</p>
          <a class="link-arrow" href="{{ p.link | localUrl(L) }}">{{ p.cta }} <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
    </article>
    {%- endfor %}
  </div>
</section>

<section class="section spotlight" aria-labelledby="spot-title">
  <div class="spot-bg" aria-hidden="true"></div>
  <div class="container spot-grid">
    <div class="spot-copy">
      <p class="eyebrow" data-reveal>{{ d.spotlight.kicker }}</p>
      <h2 class="display-lg" id="spot-title" data-reveal="1">{{ d.spotlight.title }}</h2>
      <p class="lead" data-reveal="2">{{ d.spotlight.text }}</p>
    </div>
    <div class="spot-card">{{ m.residenceCard(d.spotlight, site) }}</div>
    <dl class="specs">
      {%- for s in d.spotlight.specs %}
      <div class="spec" data-reveal="{{ loop.index0 }}"><dt>{{ s.label }}</dt><dd>{{ s.value }}</dd></div>
      {%- endfor %}
    </dl>
    <a class="btn btn-gold spot-cta" href="{{ 'golden' | localUrl(L) }}" data-reveal>{{ d.spotlight.cta }} <span class="arrow" aria-hidden="true">→</span></a>
  </div>
</section>

<section class="section advantages" aria-labelledby="adv-title">
  <div class="container">
    {{ m.sectionHead(d.advantages.kicker, d.advantages.title, d.advantages.text, "adv-title") }}
    <ul class="adv-grid">
      {%- for a in d.advantages.items %}
      <li class="adv-card" data-tilt="7" data-reveal="{{ loop.index0 }}">
        <div class="adv-media">{{ m.picture(a.image, a.image_alt, 900, 0.8, "(min-width: 1100px) 25vw, (min-width: 700px) 50vw, 100vw") }}</div>
        <div class="adv-body">
          <h3>{{ a.title }}</h3>
          <p>{{ a.text }}</p>
        </div>
        <span class="adv-shine" aria-hidden="true"></span>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>

<section class="section global" aria-labelledby="global-title">
  <div class="container global-grid">
    <div class="global-copy">
      <p class="eyebrow" data-reveal>{{ d.global.kicker }}</p>
      <h2 class="display-lg" id="global-title" data-reveal="1">{{ d.global.title }}</h2>
      <p class="lead" data-reveal="2">{{ d.global.text }}</p>
      <div class="pass" data-tilt="6" data-reveal="3">
        <div class="pass-head"><span>{{ d.global.pass_title }}</span><span class="pass-brand" lang="en" dir="ltr">G3 · BUD</span></div>
        <div class="pass-route">
          <div><span class="pass-k">{{ d.global.from_label }}</span><strong>{{ d.global.from_value }}</strong></div>
          <span class="pass-plane" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22"><path fill="currentColor" d="M21 16v-2l-8-5V3.5a1.5 1.5 0 0 0-3 0V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5z"/></svg></span>
          <div><span class="pass-k">{{ d.global.to_label }}</span><strong>{{ d.global.to_value }}</strong></div>
        </div>
        <dl class="pass-meta">
          <div><dt>{{ d.global.passenger_label }}</dt><dd>{{ d.global.passenger_value }}</dd></div>
          <div><dt>{{ d.global.date_label }}</dt><dd>{{ d.global.date_value }}</dd></div>
          <div><dt>{{ d.global.route_label }}</dt><dd>{{ d.global.route_value }}</dd></div>
          <div><dt>{{ ui.local_time }}</dt><dd><time data-clock dir="ltr">--:--</time></dd></div>
        </dl>
        <div class="pass-barcode" aria-hidden="true"></div>
      </div>
    </div>
    <div class="globe-wrap" aria-hidden="true">
      <canvas class="globe" data-globe></canvas>
      <div class="globe-fallback"></div>
    </div>
  </div>
</section>

{{ m.ctaBand(ui, L, site) }}
