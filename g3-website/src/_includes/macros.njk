{# Responsive image. ratio = width/height used for cropping Wix images. #}
{% macro picture(src, alt, w, ratio, sizes="100vw", eager=false, cls="") %}
{%- set h = (w / ratio) | round -%}
<img class="{{ cls }}" src="{{ src | img(w, h) }}"{% set ss = src | srcset(ratio) %}{% if ss %} srcset="{{ ss }}" sizes="{{ sizes }}"{% endif %} width="{{ w }}" height="{{ h }}" alt="{{ alt }}"{% if eager %} fetchpriority="high" decoding="async"{% else %} loading="lazy" decoding="async"{% endif %}>
{%- endmacro %}

{# Inner page hero with breadcrumb and layered 3D depth #}
{% macro pageHero(h, ui, L, pageKey, imageRatio=1.6) %}
<section class="page-hero{% if not h.image %} page-hero-noimg{% endif %}" data-hero>
  <div class="hero-scene">
    {%- if h.image %}
    <div class="hero-media" data-depth="0.5">{{ picture(h.image, h.image_alt, 1920, imageRatio, "100vw", true) }}</div>
    {%- else %}
    <div class="hero-media hero-media-abstract" data-depth="0.5"><div class="aurora"></div></div>
    {%- endif %}
    <div class="hero-shade"></div>
    <div class="cloud cloud-1" data-depth="1.2"></div>
    <div class="cloud cloud-2" data-depth="0.9"></div>
    <canvas class="hero-dust" aria-hidden="true"></canvas>
  </div>
  <div class="container hero-content">
    <nav class="breadcrumb" aria-label="{{ ui.breadcrumb_label }}" data-hero-fade>
      <ol><li><a href="{{ 'home' | localUrl(L) }}">{{ ui.nav.home }}</a></li><li aria-current="page">{{ ui.nav[pageKey] }}</li></ol>
    </nav>
    <p class="eyebrow" data-hero-fade>{{ h.kicker }}</p>
    <h1 class="page-title"><span class="hero-line-wrap"><span class="hero-line">{{ h.title }}</span></span></h1>
    <p class="lead" data-hero-fade>{{ h.text }}</p>
  </div>
</section>
{% endmacro %}

{# Vertical video in a 3D floating frame; loads only on click #}
{% macro videoCard(v, poster, ui) %}
{%- if v or poster %}
<figure class="video-card" data-video data-tilt="10">
  <div class="video-frame">
    <img class="video-poster" src="{{ poster | img(540, 960) }}" width="540" height="960" alt="" loading="lazy" decoding="async">
    {%- if v %}
    <video playsinline preload="none" data-src="{{ v }}" poster="{{ poster | img(540, 960) }}"></video>
    <button class="video-play" type="button" aria-label="{{ ui.video_play }}"><svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path fill="currentColor" d="M8 5.5v13l11-6.5z"/></svg></button>
    {%- endif %}
  </div>
  <div class="video-glow" aria-hidden="true"></div>
</figure>
{%- endif %}
{% endmacro %}

{# Golden residence card (CSS 3D, flips on click) #}
{% macro residenceCard(s, site) %}
<div class="rp-scene" data-card3d>
  <button class="rp-card" type="button" data-flip aria-pressed="false" aria-label="{{ s.card_title }} — {{ s.card_subtitle }}">
    <span class="rp-inner">
      <span class="rp-face rp-front" dir="ltr" lang="en">
        <span class="rp-holo" aria-hidden="true"></span>
        <span class="rp-top"><span class="rp-eu">EU</span><span>HUNGARY · MAGYARORSZÁG</span></span>
        <span class="rp-chip" aria-hidden="true"></span>
        <span class="rp-title">{{ s.card_title }}</span>
        <span class="rp-sub">{{ s.card_subtitle }}</span>
        <span class="rp-row"><span>VALID</span><b>10 YEARS</b></span>
        <span class="rp-brand">{{ site.brand.short }} · {{ site.brand.name | upper }}</span>
        <span class="rp-mrz" aria-hidden="true">IRHUN&lt;&lt;GUEST&lt;INVESTOR&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;<br>G3&lt;&lt;BUDAPEST&lt;&lt;2010&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;</span>
      </span>
      <span class="rp-face rp-back" dir="ltr" lang="en">
        <span class="rp-stripe" aria-hidden="true"></span>
        <span class="rp-back-text">SCHENGEN · 90/180</span>
        <svg class="rp-seal" viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="21" fill="none" stroke="currentColor" stroke-width="1"/><text x="24" y="29" text-anchor="middle" font-family="Cinzel, serif" font-size="14" fill="currentColor">G3</text></svg>
      </span>
    </span>
  </button>
  <div class="rp-shadow" aria-hidden="true"></div>
</div>
{% endmacro %}

{% macro ctaBand(ui, L, site) %}
<section class="cta-band" aria-labelledby="cta-title">
  <div class="cta-rings" aria-hidden="true"><span></span><span></span><span></span></div>
  <div class="container cta-inner">
    <p class="eyebrow" data-reveal>{{ ui.cta_band.kicker }}</p>
    <h2 id="cta-title" class="display-lg" data-reveal="1">{{ ui.cta_band.title }}</h2>
    <p class="lead" data-reveal="2">{{ ui.cta_band.text }}</p>
    <div class="cta-actions" data-reveal="3">
      <a class="btn btn-gold btn-lg" href="{{ 'consult' | localUrl(L) }}">{{ ui.cta_band.button }} <span class="arrow" aria-hidden="true">→</span></a>
      <a class="btn btn-ghost btn-lg" href="https://wa.me/{{ site.contact.whatsapp }}?text={{ ui.whatsapp_message | urlencode }}" rel="noopener" target="_blank">{{ ui.whatsapp }}</a>
    </div>
  </div>
</section>
{% endmacro %}

{% macro sectionHead(kicker, title, text, id) %}
<header class="section-head">
  {% if kicker %}<p class="eyebrow" data-reveal>{{ kicker }}</p>{% endif %}
  <h2 class="display-lg" id="{{ id }}" data-reveal="1">{{ title }}</h2>
  {% if text %}<p class="lead" data-reveal="2">{{ text }}</p>{% endif %}
</header>
{% endmacro %}
