{%- set L = lang.code -%}
{%- set d = i18n[L][pageKey] -%}
{%- set ui = i18n[L].ui -%}
{%- set navKeys = ["home", "immigration", "study", "golden", "about"] -%}
{%- set ogImg = (ogImage or site.seo.og_image) | img(1200, 630) -%}
<!doctype html>
<html lang="{{ L }}" dir="{{ lang.dir }}" class="no-js"{% if site.seo.ga4_id %} data-ga="{{ site.seo.ga4_id }}"{% endif %}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <script>document.documentElement.className="js";setTimeout(function(){if(!window.__ok)document.documentElement.classList.add("no-anim")},4000)</script>
  <title>{{ d.seo.title }}</title>
  <meta name="description" content="{{ d.seo.description }}">
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1">
  <link rel="canonical" href="{{ page.url | abs }}">
  {%- for l in langs %}
  <link rel="alternate" hreflang="{{ l.code }}" href="{{ pageKey | localUrl(l.code) | abs }}">
  {%- endfor %}
  <link rel="alternate" hreflang="x-default" href="{{ '/' | abs }}">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.brand.name }}">
  <meta property="og:title" content="{{ d.seo.title }}">
  <meta property="og:description" content="{{ d.seo.description }}">
  <meta property="og:url" content="{{ page.url | abs }}">
  <meta property="og:image" content="{{ ogImg }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:locale" content="{{ lang.ogLocale }}">
  {%- for l in langs %}{% if l.code != L %}
  <meta property="og:locale:alternate" content="{{ l.ogLocale }}">
  {%- endif %}{% endfor %}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ d.seo.title }}">
  <meta name="twitter:description" content="{{ d.seo.description }}">
  <meta name="twitter:image" content="{{ ogImg }}">
  {%- if site.seo.google_verification %}
  <meta name="google-site-verification" content="{{ site.seo.google_verification }}">{% endif %}
  {%- if site.seo.bing_verification %}
  <meta name="msvalidate.01" content="{{ site.seo.bing_verification }}">{% endif %}

  <meta name="theme-color" content="#070b14">
  <meta name="color-scheme" content="dark">
  <meta name="format-detection" content="telephone=no">
  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">

  <link rel="preconnect" href="https://static.wixstatic.com">
  <link rel="preload" href="/assets/fonts/{{ lang.font }}" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/fonts/{{ L }}.css">
  {%- if preloadImage %}
  {%- set pr = preloadRatio or 1.51 %}
  <link rel="preload" as="image" href="{{ preloadImage | img(1920, (1920 / pr) | round) }}" imagesrcset="{{ preloadImage | srcset(pr) }}" imagesizes="100vw" fetchpriority="high">
  {%- endif %}
  <link rel="stylesheet" href="/assets/css/main.css">
  <script type="module" src="/assets/js/main.js"></script>
  <script type="application/ld+json">{{ pageKey | schema({ lang: lang, i18n: i18n, site: site }) | safe }}</script>
</head>
<body class="lang-{{ L }} page-{{ pageKey }}">
  <a class="skip-link" href="#main">{{ ui.skip_link }}</a>

  <header class="site-header" data-header>
    <a class="brand" href="{{ 'home' | localUrl(L) }}" aria-label="{{ site.brand.name }} — {{ ui.nav.home }}">
      {%- if site.brand.logo %}
      <img class="brand-logo" src="{{ site.brand.logo }}" alt="{{ site.brand.logo_alt }}" width="160" height="48">
      {%- else %}
      {% include "partials/mark.njk" %}
      <span class="brand-word" lang="en" dir="ltr">Guide Group <em>Global</em></span>
      {%- endif %}
    </a>
    <nav class="nav-desktop" aria-label="{{ ui.nav_label }}">
      <ul>
        {%- for k in navKeys %}{% if k != "home" %}
        <li><a href="{{ k | localUrl(L) }}"{% if k == pageKey %} aria-current="page"{% endif %}><span class="nav-n" aria-hidden="true">{{ loop.index0 | pad2(L) }}</span>{{ ui.nav[k] }}</a></li>
        {%- endif %}{% endfor %}
      </ul>
    </nav>
    <div class="header-actions">
      <ul class="lang-switch" aria-label="{{ ui.lang_switch }}">
        {%- for l in langs %}
        <li><a href="{{ pageKey | localUrl(l.code) }}" hreflang="{{ l.code }}" lang="{{ l.code }}" data-lang-link="{{ l.code }}" title="{{ l.name }}"{% if l.code == L %} aria-current="true"{% endif %}>{{ l.short }}</a></li>
        {%- endfor %}
      </ul>
      <a class="btn btn-gold btn-sm header-cta" href="{{ 'consult' | localUrl(L) }}">{{ ui.cta_consult }}</a>
      <button class="menu-toggle" type="button" data-menu-toggle aria-controls="site-menu" aria-expanded="false" aria-label="{{ ui.menu_open }}" data-label-open="{{ ui.menu_open }}" data-label-close="{{ ui.menu_close }}">
        <span></span><span></span>
      </button>
    </div>
  </header>

  <div class="menu-overlay" id="site-menu" hidden aria-hidden="true">
    <div class="menu-inner">
      <nav aria-label="{{ ui.nav_label }} — {{ ui.menu_close }}">
        <ol class="menu-list">
          {%- for k in navKeys %}
          <li style="--i:{{ loop.index0 }}"><a href="{{ k | localUrl(L) }}"{% if k == pageKey %} aria-current="page"{% endif %}><span class="menu-n" aria-hidden="true">{{ loop.index | pad2(L) }}</span>{{ ui.nav[k] }}</a></li>
          {%- endfor %}
          <li style="--i:5"><a class="menu-cta" href="{{ 'consult' | localUrl(L) }}"><span class="menu-n" aria-hidden="true">{{ 6 | pad2(L) }}</span>{{ ui.nav.consult }}</a></li>
        </ol>
      </nav>
      <div class="menu-aside">
        <p class="eyebrow">{{ ui.footer.contact_title }}</p>
        <a href="tel:{{ site.contact.phone_1 }}"><bdi dir="ltr">{{ site.contact.phone_1_display | nbsp }}</bdi></a>
        <a href="mailto:{{ site.contact.email }}"><bdi dir="ltr">{{ site.contact.email }}</bdi></a>
        <ul class="lang-switch lang-switch-lg" aria-label="{{ ui.lang_switch }}">
          {%- for l in langs %}
          <li><a href="{{ pageKey | localUrl(l.code) }}" hreflang="{{ l.code }}" lang="{{ l.code }}" data-lang-link="{{ l.code }}"{% if l.code == L %} aria-current="true"{% endif %}>{{ l.name }}</a></li>
          {%- endfor %}
        </ul>
      </div>
    </div>
  </div>

  <main id="main" tabindex="-1">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="footer-marquee" aria-hidden="true">
      <div class="marquee-track" dir="ltr">
        {%- for i in range(0, 4) %}<span>Guide Group Global</span><span class="dot">✦</span><span>Budapest · Since 2010</span><span class="dot">✦</span>{% endfor %}
      </div>
    </div>
    <div class="container footer-grid">
      <div class="footer-brand">
        <a class="brand" href="{{ 'home' | localUrl(L) }}" aria-label="{{ site.brand.name }}">
          {% set markId = "f" %}{% include "partials/mark.njk" %}
          <span class="brand-word" lang="en" dir="ltr">Guide Group <em>Global</em></span>
        </a>
        <p>{{ ui.footer.tagline }}</p>
        <a class="btn btn-gold" href="{{ 'consult' | localUrl(L) }}">{{ ui.cta_consult }}</a>
      </div>
      <div>
        <h2 class="footer-title">{{ ui.footer.contact_title }}</h2>
        <address>
          <a href="{{ site.contact.map_url }}" rel="noopener" target="_blank">{% include "partials/address.njk" %}</a>
          <a href="tel:{{ site.contact.phone_1 }}"><bdi dir="ltr">{{ site.contact.phone_1_display | nbsp }}</bdi></a>
          <a href="tel:{{ site.contact.phone_2 }}"><bdi dir="ltr">{{ site.contact.phone_2_display | nbsp }}</bdi></a>
          <a href="mailto:{{ site.contact.email }}"><bdi dir="ltr">{{ site.contact.email }}</bdi></a>
          <a href="https://wa.me/{{ site.contact.whatsapp }}" rel="noopener" target="_blank">{{ ui.whatsapp }}</a>
        </address>
      </div>
      <div>
        <h2 class="footer-title">{{ ui.footer.pages_title }}</h2>
        <ul class="footer-links">
          {%- for k in navKeys %}<li><a href="{{ k | localUrl(L) }}">{{ ui.nav[k] }}</a></li>{% endfor %}
          <li><a href="{{ 'consult' | localUrl(L) }}">{{ ui.nav.consult }}</a></li>
          <li><a href="{{ 'privacy' | localUrl(L) }}">{{ ui.nav.privacy }}</a></li>
        </ul>
      </div>
      <div>
        <h2 class="footer-title">{{ ui.footer.social_title }}</h2>
        <ul class="footer-links">
          {%- for name, url in site.social %}{% if url %}
          <li><a href="{{ url }}" rel="noopener me" target="_blank" lang="en">{{ name | capitalize }}</a></li>
          {%- endif %}{% endfor %}
        </ul>
        <h2 class="footer-title footer-title-gap">{{ ui.footer.company_title }}</h2>
        <p class="footer-legal">
          {{ ui.footer.company_intro }} <bdi>{{ site.company.legal_name }}</bdi><br>
          {{ ui.footer.reg_label }}: <bdi dir="ltr">{{ site.company.registration_number }}</bdi><br>
          {{ ui.footer.tax_label }}: <bdi dir="ltr">{{ site.company.tax_number }}</bdi>
        </p>
      </div>
    </div>
    <div class="container footer-bottom">
      <p>© <bdi>{{ site.year }}</bdi> {{ site.brand.name }}. {{ ui.footer.rights }}</p>
      <p class="footer-disclaimer">{{ ui.disclaimer }}</p>
      <a class="back-top" href="#main">{{ ui.footer.back_top }} <span aria-hidden="true">↑</span></a>
    </div>
  </footer>

  <a class="wa-float" href="https://wa.me/{{ site.contact.whatsapp }}?text={{ ui.whatsapp_message | urlencode }}" rel="noopener" target="_blank" aria-label="{{ ui.whatsapp }}">
    <svg viewBox="0 0 32 32" width="26" height="26" aria-hidden="true"><path fill="currentColor" d="M16 3a13 13 0 0 0-11.2 19.6L3 29l6.6-1.7A13 13 0 1 0 16 3Zm0 23.6c-2 0-4-.6-5.7-1.6l-.4-.2-3.9 1 1-3.8-.3-.4A10.6 10.6 0 1 1 16 26.6Zm5.8-7.9c-.3-.2-1.9-.9-2.2-1s-.5-.2-.7.2l-1 1.2c-.2.2-.4.2-.7.1a8.7 8.7 0 0 1-4.3-3.8c-.3-.6.3-.5.9-1.7.1-.2 0-.4 0-.5l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.1 1.1-1.1 2.7s1.2 3.2 1.3 3.4c.2.2 2.3 3.5 5.6 4.9 2.1.9 2.9 1 4 .8.6-.1 1.9-.8 2.2-1.5.3-.8.3-1.4.2-1.5-.1-.2-.3-.2-.6-.4Z"/></svg>
  </a>

  {%- if site.seo.ga4_id %}
  <div class="consent" data-consent hidden role="region" aria-label="Cookies">
    <p>{{ ui.consent_text }} <a href="{{ 'privacy' | localUrl(L) }}">{{ ui.nav.privacy }}</a></p>
    <div><button class="btn btn-ghost btn-sm" data-consent-choice="no" type="button">{{ ui.consent_no }}</button><button class="btn btn-gold btn-sm" data-consent-choice="yes" type="button">{{ ui.consent_yes }}</button></div>
  </div>
  {%- endif %}
</body>
</html>
